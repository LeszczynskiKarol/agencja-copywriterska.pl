---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import Stats from '../../../components/Stats.astro';
import Testimonial from '../../../components/Testimonial.astro';

const pageTitle = "Opisy Produktów - Profesjonalne Opisy do Sklepu Internetowego | Agencja Copywriterska";
const pageDescription = "Opisy produktów do sklepu internetowego ✓ Unikalne opisy produktów ✓ SEO ✓ Zwiększenie sprzedaży ✓ E-commerce ✓ 10000+ napisanych opisów. Zamów opisy produktów!";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Strona główna",
      "item": "https://www.agencja-copywriterska.pl"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Usługi",
      "item": "https://www.agencja-copywriterska.pl/uslugi"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Opisy produktów",
      "item": "https://www.agencja-copywriterska.pl/uslugi/opisy-produktow"
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Opisy produktów",
  "name": "Profesjonalne Opisy Produktów do Sklepów Internetowych",
  "description": "Profesjonalne pisanie opisów produktów do sklepów internetowych. Unikalne, SEO-friendly opisy zwiększające sprzedaż i konwersję w e-commerce.",
  "provider": {
    "@type": "Organization",
    "name": "Agencja Copywriterska",
    "url": "https://www.agencja-copywriterska.pl",
    "telephone": "+48509370772",
    "email": "kontakt@agencja-copywriterska.pl",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Toruń",
      "addressCountry": "PL"
    }
  },
  "areaServed": {
    "@type": "Country",
    "name": "Polska"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Usługi opisów produktów",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Opisy produktów SEO"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Opisy produktów e-commerce"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Opisy produktów hurtowe"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Opisy produktów premium"
        }
      }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Ile kosztuje opis produktu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cena opisu produktu zależy od długości i złożoności. Krótki opis (100-150 słów) to koszt od 25-40 zł, standardowy opis (200-300 słów) od 40-70 zł, a rozbudowany opis premium (400+ słów) od 80-150 zł. Przy większych zamówieniach oferujemy rabaty ilościowe."
      }
    },
    {
      "@type": "Question",
      "name": "Jak długo trwa napisanie opisów produktów?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Czas realizacji zależy od ilości produktów. 10-20 opisów to 3-5 dni roboczych. 50-100 opisów to 1-2 tygodnie. Większe projekty (500+ opisów) realizujemy według ustalonego harmonogramu. Pilne zlecenia możemy przyspieszyć."
      }
    },
    {
      "@type": "Question",
      "name": "Czy opisy produktów są unikalne?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak, każdy opis piszemy od podstaw. Gwarantujemy 100% unikalności – wszystkie opisy przechodzą weryfikację antyplagiatową. Unikalne opisy są niezbędne dla SEO i unikania duplicate content."
      }
    },
    {
      "@type": "Question",
      "name": "Czy opisy są zoptymalizowane pod SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak, wszystkie opisy produktów są domyślnie zoptymalizowane pod wyszukiwarki. Naturalne rozmieszczenie słów kluczowych, właściwa struktura, meta opisy. Pomagamy produktom być widocznym w Google."
      }
    },
    {
      "@type": "Question",
      "name": "Dla jakich platform e-commerce piszecie opisy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Piszemy opisy produktów dla wszystkich platform: WooCommerce, PrestaShop, Magento, Shopify, IdoSell, Shoper, Sky-Shop, BaseLinker i innych. Dostosowujemy format do wymagań konkretnej platformy."
      }
    },
    {
      "@type": "Question",
      "name": "Czy potrzebuję dostarczyć zdjęcia produktów?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Zdjęcia są pomocne, ale nie niezbędne. Potrzebujemy specyfikacji technicznej produktów, linków do strony producenta lub podobnych produktów. Im więcej informacji dostarczysz, tym lepszy opis napiszemy."
      }
    },
    {
      "@type": "Question",
      "name": "Czy piszecie opisy w językach obcych?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak, oferujemy opisy produktów w języku angielskim i niemieckim. Tłumaczymy również istniejące opisy polskie na języki obce. Dla innych języków współpracujemy z native speakerami."
      }
    },
    {
      "@type": "Question",
      "name": "Czy mogę zamówić próbny opis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak! Przy większych zamówieniach oferujemy wykonanie 1-2 próbnych opisów, abyś mógł ocenić styl i jakość przed zleceniem całości. To pozwala dopracować ton i format opisów."
      }
    }
  ]
};

