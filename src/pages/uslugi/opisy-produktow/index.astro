---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords="opisy produktów, pisanie opisów produktów, opisy produktów do sklepu, opisy produktów e-commerce, opisy produktów SEO, unikalne opisy produktów, copywriting e-commerce"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Opisy produktów</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__bg">
      <div class="hero__pattern"></div>
      <div class="hero__gradient"></div>
    </div>
    <div class="container">
      <div class="hero__content">
        <span class="hero__badge animate-fade-in">Opisy, które sprzedają</span>
        <h1 class="hero__title animate-fade-in" style="animation-delay: 0.1s">
          <strong>Opisy produktów</strong> do sklepu internetowego
        </h1>
        <p class="hero__subtitle animate-fade-in" style="animation-delay: 0.2s">
          Profesjonalne <strong>pisanie opisów produktów</strong> dla e-commerce. Unikalne, zoptymalizowane 
          pod SEO treści, które zwiększają konwersję i pomagają sprzedawać. Ponad 10&nbsp;000 napisanych 
          opisów, 150+ obsłużonych sklepów.
        </p>
        <div class="hero__cta animate-fade-in" style="animation-delay: 0.3s">
          <a href="/kontakt/" class="btn btn--primary btn--lg">
            Zamów opisy produktów
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="#cennik" class="btn btn--secondary btn--lg">
            Zobacz cennik
          </a>
        </div>
        <div class="hero__trust animate-fade-in" style="animation-delay: 0.4s">
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>10 000+ opisów</span>
          </div>
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>100% unikalności</span>
          </div>
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>+35% konwersji</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="container">
      <Stats items={stats} variant="dark" />
    </div>
  </section>

  <!-- What is Section -->
  <section class="section what-is" id="o-usludze">
    <div class="container">
      <div class="what-is__grid">
        <div class="what-is__content">
          <SectionHeading
            label="O usłudze"
            title="Dlaczego <span class='accent'>opisy produktów</span> są tak ważne?"
            align="left"
          />
          <div class="what-is__text">
            <p>
              W e-commerce klient nie może dotknąć produktu, przymierzyć go ani zobaczyć na żywo. 
              <strong>Opis produktu</strong> to Twój sprzedawca – musi przekonać, odpowiedzieć na pytania 
              i rozwiać wątpliwości. Dobry opis to różnica między porzuconym koszykiem a finalizacją zakupu.
            </p>
            <p>
              <strong>Profesjonalne opisy produktów</strong> nie tylko informują – sprzedają. Używają języka 
              korzyści, odpowiadają na potrzeby klienta i budują zaufanie do marki. Jednocześnie są 
              zoptymalizowane pod SEO, pomagając produktom być widocznym w Google i Google Shopping.
            </p>
            <p>
              Napisaliśmy ponad 10&nbsp;000 <strong>opisów produktów</strong> dla sklepów z różnych branż. 
              Wiemy, jak pisać, żeby klient dodał produkt do koszyka. Średni wzrost konwersji u naszych 
              klientów to 35%.
            </p>
          </div>
        </div>
        <div class="what-is__visual">
          <div class="what-is__card">
            <div class="what-is__card-icon">🛒</div>
            <h3>Opis = Twój sprzedawca 24/7</h3>
            <p>Dobry opis produktu pracuje na Ciebie przez całą dobę, przekonując klientów do zakupu.</p>
          </div>
          <div class="what-is__highlight">
            <span class="what-is__highlight-number">+35%</span>
            <span class="what-is__highlight-text">średni wzrost konwersji po wdrożeniu naszych opisów</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Description Types Section -->
  <section class="section desc-types" id="rodzaje-opisow">
    <div class="container">
      <SectionHeading
        label="Rodzaje opisów"
        title="Jakie <span class='accent'>opisy produktów</span> piszemy?"
        subtitle="Od krótkich notek po rozbudowane opisy premium"
        align="center"
      />
      <div class="desc-types__grid">
        {descriptionTypes.map((type, index) => (
          <article class="desc-card animate-fade-in" style={`animation-delay: ${index * 0.1}s`}>
            <span class="desc-card__icon">{type.icon}</span>
            <h3 class="desc-card__title">{type.title}</h3>
            <p class="desc-card__description">{type.description}</p>
            <div class="desc-card__price">{type.price}</div>
            <ul class="desc-card__features">
              {type.features.map(feature => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Industries Section -->
  <section class="section industries" id="branze">
    <div class="container">
      <SectionHeading
        label="Branże"
        title="<span class='accent'>Opisy produktów</span> dla każdej branży"
        subtitle="Rozumiemy specyfikę różnych kategorii e-commerce"
        align="center"
      />
      <div class="industries__grid">
        {industries.map((industry, index) => (
          <div class="industry-card animate-fade-in" style={`animation-delay: ${index * 0.05}s`}>
            <span class="industry-card__icon">{industry.icon}</span>
            <span class="industry-card__name">{industry.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Platforms Section -->
  <section class="section platforms" id="platformy">
    <div class="platforms__bg"></div>
    <div class="container">
      <SectionHeading
        label="Platformy"
        title="Piszemy dla <span class='accent'>wszystkich platform</span> e-commerce"
        subtitle="Format opisów dopasowany do wymagań Twojego sklepu"
        align="center"
      />
      <div class="platforms__grid">
        {platforms.map((platform, index) => (
          <div class="platform-tag animate-fade-in" style={`animation-delay: ${index * 0.05}s`}>
            {platform}
          </div>
        ))}
      </div>
      <p class="platforms__note">
        Nie widzisz swojej platformy? Piszemy dla każdego systemu e-commerce. 
        <a href="/kontakt/">Skontaktuj się z nami</a>.
      </p>
    </div>
  </section>

  <!-- Pricing Section -->
