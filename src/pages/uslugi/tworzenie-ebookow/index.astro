    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-6);
  }
  
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-6);
    color: var(--color-text-primary);
  }
  
  .hero__title strong {
    color: var(--color-accent);
  }
  
  .hero__subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }
  
  .hero__subtitle strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }
  
  .hero__cta {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-10);
  }
  
  .hero__trust {
    display: flex;
    gap: var(--space-6);
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .hero__trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  
  .hero__trust-item svg {
    color: var(--color-success);
  }

  /* Stats Section */
  .stats-section {
    margin-top: calc(var(--space-16) * -1);
    position: relative;
    z-index: 10;
    padding-bottom: var(--space-16);
  }

  /* Section Base */
  .section {
    padding: var(--space-20) 0;
  }

  /* What is Section */
  .what-is {
    background: var(--color-bg-primary);
  }
  
  .what-is__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  
  @media (min-width: 1024px) {
    .what-is__grid {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }
  
  .what-is__text {
    margin-top: var(--space-6);
  }
  
  .what-is__text p {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }
  
  .what-is__text p:last-child {
    margin-bottom: 0;
  }
  
  .what-is__text strong {
    color: var(--color-text-primary);
  }
  
  .what-is__text a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  
  .what-is__visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  
  .what-is__card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-align: center;
  }
  
  .what-is__card-icon {
    font-size: 3rem;
    margin-bottom: var(--space-4);
  }
  
  .what-is__card h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-3);
    color: var(--color-text-primary);
  }
  
  .what-is__card p {
    color: var(--color-text-secondary);
  }
  
  .what-is__highlight {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    text-align: center;
    color: white;
  }
  
  .what-is__highlight-number {
    display: block;
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: var(--space-2);
    color: var(--color-accent);
  }
  
  .what-is__highlight-text {
    font-size: var(--text-sm);
    opacity: 0.9;
  }

  /* Ebook Types Section */
  .ebook-types {
    background: var(--color-bg-secondary);
  }
  
  .ebook-types__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-12);
  }
  
  @media (min-width: 768px) {
    .ebook-types__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .ebook-types__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .ebook-card {
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .ebook-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }
  
  .ebook-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  
  .ebook-card:hover::before {
    transform: scaleX(1);
  }
  
  .ebook-card__icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-4);
    display: block;
  }
  
  .ebook-card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-3);
    color: var(--color-text-primary);
  }
  
  .ebook-card__description {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }
  
  .ebook-card__timeline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }
  
  .ebook-card__features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  
  .ebook-card__features li {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    background: var(--color-bg-secondary);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }
  
  .ebook-card__features svg {
    color: var(--color-success);
    flex-shrink: 0;
  }

  /* Services Detail Section */
  .services-detail {
    background: var(--color-bg-primary);
  }
  
  .services-detail__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-12);
  }
  
  @media (min-width: 768px) {
    .services-detail__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .services-detail__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .service-detail-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    transition: all 0.3s ease;
  }
  
  .service-detail-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  
  .service-detail-card__icon {
    font-size: 2rem;
    margin-bottom: var(--space-3);
    display: block;
  }
  
  .service-detail-card__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }
  
  .service-detail-card__description {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }
  
  .service-detail-card__features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  
  .service-detail-card__features li {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    background: var(--color-bg-primary);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  /* Packages Section */
  .packages {
    position: relative;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  }
  
  .packages__bg {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(circle at 20% 50%, rgba(252, 187, 66, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(252, 187, 66, 0.05) 0%, transparent 40%);
  }
  
  .packages .container {
    position: relative;
    z-index: 1;
  }
  
  .packages :global(.section-heading__label) {
    color: var(--color-accent);
  }
  
  .packages :global(.section-heading__title),
  .packages :global(.section-heading__subtitle) {
    color: white;
  }
  
  .packages :global(.section-heading__title .accent) {
    color: var(--color-accent);
  }
  
  .packages__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-12);
  }
  
  @media (min-width: 768px) {
    .packages__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .package-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-align: center;
    transition: all 0.3s ease;
    position: relative;
  }
  
  .package-card:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-4px);
  }
  
  .package-card--highlighted {
    background: white;
    border-color: var(--color-accent);
    transform: scale(1.05);
  }
  
  .package-card--highlighted:hover {
    background: white;
    transform: scale(1.05) translateY(-4px);
  }
  
  .package-card__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }
  
  .package-card__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: white;
    margin-bottom: var(--space-2);
  }
  
  .package-card--highlighted .package-card__name {
    color: var(--color-primary);
  }
  
  .package-card__description {
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }
  
  .package-card--highlighted .package-card__description {
    color: var(--color-text-secondary);
  }
  
  .package-card__price {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: var(--space-6);
  }
  
  .package-card__features {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6) 0;
    text-align: left;
  }
  
  .package-card__features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.8);
    padding: var(--space-2) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .package-card--highlighted .package-card__features li {
    color: var(--color-text-secondary);
    border-color: var(--color-border);
  }
  
  .package-card__features li:last-child {
    border-bottom: none;
  }
  
  .package-card__features svg {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }
  
  .package-card__btn {
    display: block;
    width: 100%;
    text-align: center;
    padding: var(--space-3) var(--space-4);
    background: var(--color-accent);
    color: var(--color-primary);
    border-radius: var(--radius-lg);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-sm);
    transition: all 0.2s ease;
  }
  
  .package-card__btn:hover {
    background: var(--color-accent-dark);
  }
  
  .packages__note {
    text-align: center;
    margin-top: var(--space-8);
    color: rgba(255, 255, 255, 0.7);
  }
  
  .packages__note a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Publishing Section */
  .publishing {
    background: var(--color-bg-secondary);
  }
  
  .publishing__grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
    margin-top: var(--space-10);
  }
  
  .publishing-card {
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-6);
    text-align: center;
    transition: all 0.2s ease;
    min-width: 180px;
  }
  
  .publishing-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  
  .publishing-card__name {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }
  
  .publishing-card__type {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
  
  .publishing__note {
    text-align: center;
    margin-top: var(--space-8);
    color: var(--color-text-secondary);
  }

  /* Process Section */
  .process {
    position: relative;
    background: var(--color-bg-primary);
  }
  
  .process__bg {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(circle at 20% 50%, rgba(252, 187, 66, 0.05) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(18, 25, 58, 0.03) 0%, transparent 40%);
  }
  
  .process .container {
    position: relative;
    z-index: 1;
  }
  
  .process__timeline {
    max-width: 700px;
    margin: var(--space-12) auto 0;
    position: relative;
  }
  
  .process__timeline::before {
    content: "";
    position: absolute;
    left: 29px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }
  
  @media (min-width: 768px) {
    .process__timeline::before {
      left: 50%;
      transform: translateX(-50%);
    }
  }
  
  .process-step {
    position: relative;
    display: flex;
    gap: var(--space-6);
    padding-bottom: var(--space-8);
  }
  
  @media (min-width: 768px) {
    .process-step {
      justify-content: center;
      text-align: center;
      flex-direction: column;
      align-items: center;
    }
  }
  
  .process-step__marker {
    position: relative;
    z-index: 1;
  }
  
  .process-step__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: var(--color-accent);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    border-radius: var(--radius-full);
  }
  
  .process-step__content {
    flex: 1;
  }
  
  @media (min-width: 768px) {
    .process-step__content {
      max-width: 400px;
    }
  }
  
  .process-step__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }
  
  .process-step__description {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  
  .process__cta {
    text-align: center;
    margin-top: var(--space-8);
  }

  /* Benefits Section */
  .benefits {
    background: var(--color-bg-secondary);
  }
  
  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-12);
  }
  
  @media (min-width: 768px) {
    .benefits__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .benefits__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .benefit-card {
    text-align: center;
    padding: var(--space-8);
    background: var(--color-bg-primary);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    transition: all 0.3s ease;
  }
  
  .benefit-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  
  .benefit-card__icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-4);
    display: block;
  }
  
  .benefit-card__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }
  
  .benefit-card__description {
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Testimonials Section */
  .testimonials {
    background: var(--color-bg-primary);
  }
  
  .testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-12);
  }
  
  @media (min-width: 768px) {
    .testimonials__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* FAQ Section */
  .faq {
    background: var(--color-bg-secondary);
  }
  
  .faq__list {
    max-width: 800px;
    margin: var(--space-12) auto 0;
  }
  
  .faq__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
    overflow: hidden;
    transition: all 0.3s ease;
  }
  
  .faq__item:hover {
    border-color: var(--color-accent);
  }
  
  .faq__item[open] {
    border-color: var(--color-accent);
    box-shadow: 0 4px 20px rgba(252, 187, 66, 0.1);
  }
  
  .faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-5) var(--space-6);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-primary);
    background: var(--color-bg-primary);
    list-style: none;
    transition: all 0.2s ease;
  }
  
  .faq__question::-webkit-details-marker {
    display: none;
  }
  
  .faq__question:hover {
    background: var(--color-bg-tertiary);
  }
  
  .faq__question svg {
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: var(--color-accent);
  }
  
  .faq__item[open] .faq__question svg {
    transform: rotate(180deg);
  }
  
  .faq__answer {
    padding: var(--space-6);
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
  }
  
  .faq__answer p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }
  
  .faq__answer a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  
  .faq__answer a:hover {
    color: var(--color-accent-dark);
  }

  /* SEO Content Section */
  .seo-content {
    background: var(--color-bg-primary);
  }
  
  .seo-content__article {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .seo-content__article h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    margin-bottom: var(--space-6);
    color: var(--color-text-primary);
  }
  
  .seo-content__article h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
  }
  
  .seo-content__article p {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }
  
  .seo-content__article strong {
    color: var(--color-text-primary);
  }
  
  .seo-content__article a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }
  
  .seo-content__article a:hover {
    color: var(--color-accent-dark);
  }
  
  .seo-content__contact {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    margin-top: var(--space-10);
  }
  
  .seo-content__contact h3 {
    margin-top: 0;
    margin-bottom: var(--space-4);
  }
  
  .seo-content__contact p {
    margin-bottom: var(--space-2);
    font-size: var(--text-base);
  }
  
