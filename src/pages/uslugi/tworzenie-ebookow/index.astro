const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Ile kosztuje stworzenie ebooka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Koszt tworzenia ebooka zależy od objętości, tematyki i zakresu usług. Krótkie ebooki (20-30 stron) zaczynają się od 2000 zł, średnie (50-80 stron) od 4000 zł, a kompleksowe publikacje (100+ stron) wyceniamy indywidualnie. Cena obejmuje pisanie, skład, redakcję i korektę."
      }
    },
    {
      "@type": "Question",
      "name": "Jak długo trwa stworzenie ebooka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Czas realizacji zależy od objętości i złożoności projektu. Krótki ebook (20-30 stron) to około 2-3 tygodnie. Średni ebook (50-80 stron) to 4-6 tygodni. Kompleksowa publikacja (100+ stron) może zająć 2-3 miesiące. Zawsze ustalamy harmonogram indywidualnie."
      }
    },
    {
      "@type": "Question",
      "name": "Co obejmuje usługa tworzenia ebooka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nasza usługa obejmuje pełen proces: research i planowanie struktury, pisanie treści, profesjonalny skład w LaTeX lub InDesign, redakcję językową i merytoryczną, korektę, projekt graficzny okładki oraz przygotowanie plików do publikacji (PDF, EPUB, MOBI)."
      }
    },
    {
      "@type": "Question",
      "name": "Czy pomagacie w publikacji ebooka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak! Współpracujemy z wydawnictwami i platformami publikacyjnymi. Możemy pomóc w publikacji na Amazon Kindle, Google Play Books, Legimi, Empik Go i innych platformach. Dostarczamy pliki w formatach wymaganych przez konkretne serwisy."
      }
    },
    {
      "@type": "Question",
      "name": "Czy mogę zamówić tylko część usługi, np. sam skład?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oczywiście! Oferujemy zarówno kompleksową realizację, jak i pojedyncze usługi: samo pisanie, sam skład LaTeX, samą redakcję lub korektę. Dopasowujemy zakres prac do Twoich potrzeb i budżetu."
      }
    },
    {
      "@type": "Question",
      "name": "W jakich formatach dostarczacie gotowego ebooka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standardowo dostarczamy ebooka w formacie PDF (print-ready i web-optimized). Na życzenie przygotowujemy również formaty EPUB i MOBI do czytników e-booków. Pliki są gotowe do publikacji i dystrybucji."
      }
    },
    {
      "@type": "Question",
      "name": "Czy tworzycie ebooki na tematy specjalistyczne?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak, mamy doświadczenie w tworzeniu ebooków z wielu branż: biznes, marketing, IT, finanse, prawo, medycyna, edukacja i wiele innych. Przeprowadzamy dokładny research i w razie potrzeby konsultujemy treści z ekspertami."
      }
    },
    {
      "@type": "Question",
      "name": "Czy mogę dostarczyć własne materiały do ebooka?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak! Możesz dostarczyć własne materiały źródłowe, notatki, prezentacje lub nawet surowy tekst. My zajmiemy się ich opracowaniem, rozwinięciem, składem i redakcją. To świetna opcja dla ekspertów, którzy mają wiedzę, ale brakuje im czasu na pisanie."
      }
    }
  ]
};

