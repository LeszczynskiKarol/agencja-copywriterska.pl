---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords="opisy kategorii, opisy kategorii do sklepu, opisy kategorii e-commerce, opisy kategorii SEO, pisanie opisów kategorii, opisy kategorii sklep internetowy"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Opisy kategorii</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__bg">
      <div class="hero__pattern"></div>
      <div class="hero__gradient"></div>
    </div>
    <div class="container">
      <div class="hero__content">
        <span class="hero__badge animate-fade-in">SEO dla e-commerce</span>
        <h1 class="hero__title animate-fade-in" style="animation-delay: 0.1s">
          <strong>Opisy kategorii</strong> do sklepu internetowego
        </h1>
        <p class="hero__subtitle animate-fade-in" style="animation-delay: 0.2s">
          Profesjonalne <strong>opisy kategorii</strong> zoptymalizowane pod SEO. Zwiększ widoczność 
          swojego sklepu w Google, przyciągnij więcej klientów i popraw pozycje na frazy produktowe. 
          Ponad 2000 napisanych opisów kategorii.
        </p>
        <div class="hero__cta animate-fade-in" style="animation-delay: 0.3s">
          <a href="/kontakt/" class="btn btn--primary btn--lg">
            Zamów opisy kategorii
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="#cennik" class="btn btn--secondary btn--lg">
            Zobacz cennik
          </a>
        </div>
        <div class="hero__trust animate-fade-in" style="animation-delay: 0.4s">
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>2000+ opisów kategorii</span>
          </div>
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>+45% ruchu organicznego</span>
          </div>
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Research słów kluczowych</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="container">
      <Stats items={stats} variant="dark" />
    </div>
  </section>

  <!-- What is Section -->
  <section class="section what-is" id="o-usludze">
    <div class="container">
      <div class="what-is__grid">
        <div class="what-is__content">
          <SectionHeading
            label="O usłudze"
            title="Dlaczego <span class='accent'>opisy kategorii</span> są tak ważne dla SEO?"
            align="left"
          />
          <div class="what-is__text">
            <p>
              <strong>Opisy kategorii</strong> to jeden z najważniejszych, a często pomijanych elementów 
              SEO w e-commerce. Google traktuje strony kategorii jako kluczowe podstrony sklepu – to na 
              nich użytkownicy szukają grup produktów i to one mogą rankować na ogólne frazy produktowe.
            </p>
            <p>
              Wiele sklepów ma puste strony kategorii lub jedynie automatycznie wygenerowane listy produktów. 
              To zmarnowany potencjał SEO. <strong>Profesjonalne opisy kategorii</strong> dają Google 
              unikalną treść do indeksowania i pomagają stronom kategorii wyświetlać się wyżej w wynikach.
            </p>
            <p>
              Napisaliśmy ponad 2000 <strong>opisów kategorii</strong> dla sklepów z różnych branż. 
              Nasi klienci notują średnio 45% wzrost ruchu organicznego na stronach kategorii. To 
              inwestycja, która zwraca się w postaci większej widoczności i sprzedaży.
            </p>
          </div>
        </div>
        <div class="what-is__visual">
          <div class="what-is__card">
            <div class="what-is__card-icon">📊</div>
            <h3>Kategoria = strona do pozycjonowania</h3>
            <p>Każda kategoria w Twoim sklepie to osobna szansa na zdobycie ruchu z Google na wartościowe frazy.</p>
          </div>
          <div class="what-is__highlight">
            <span class="what-is__highlight-number">+45%</span>
            <span class="what-is__highlight-text">średni wzrost ruchu organicznego na stronach kategorii</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO Elements Section -->
  <section class="section seo-elements" id="elementy-seo">
    <div class="container">
      <SectionHeading
        label="Elementy SEO"
        title="Co zawierają nasze <span class='accent'>opisy kategorii</span>?"
        subtitle="Kompletna optymalizacja dla maksymalnej widoczności w Google"
        align="center"
      />
      <div class="seo-elements__grid">
        {seoElements.map((element, index) => (
          <div class="seo-element-card animate-fade-in" style={`animation-delay: ${index * 0.1}s`}>
            <span class="seo-element-card__icon">{element.icon}</span>
            <h3 class="seo-element-card__title">{element.title}</h3>
            <p class="seo-element-card__description">{element.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Description Types Section -->
  <section class="section desc-types" id="rodzaje-opisow">
    <div class="container">
      <SectionHeading
        label="Rodzaje opisów"
        title="Jakie <span class='accent'>opisy kategorii</span> oferujemy?"
        subtitle="Od krótkich wprowadzeń po rozbudowane treści SEO"
        align="center"
      />
      <div class="desc-types__grid">
        {descriptionTypes.map((type, index) => (
          <article class="desc-card animate-fade-in" style={`animation-delay: ${index * 0.1}s`}>
            <span class="desc-card__icon">{type.icon}</span>
            <h3 class="desc-card__title">{type.title}</h3>
            <p class="desc-card__description">{type.description}</p>
            <div class="desc-card__price">{type.price}</div>
            <ul class="desc-card__features">
              {type.features.map(feature => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Industries Section -->
  <section class="section industries" id="branze">
    <div class="industries__bg"></div>
    <div class="container">
      <SectionHeading
        label="Branże"
        title="<span class='accent'>Opisy kategorii</span> dla każdej branży e-commerce"
        subtitle="Rozumiemy specyfikę różnych segmentów rynku"
        align="center"
      />
      <div class="industries__grid">
        {industries.map((industry, index) => (
          <div class="industry-card animate-fade-in" style={`animation-delay: ${index * 0.05}s`}>
            <span class="industry-card__icon">{industry.icon}</span>
            <span class="industry-card__name">{industry.name}</span>
          </div>
        ))}
      </div>
      <div class="platforms__grid">
        {platforms.map((platform, index) => (
          <div class="platform-tag animate-fade-in" style={`animation-delay: ${index * 0.05}s`}>
            {platform}
