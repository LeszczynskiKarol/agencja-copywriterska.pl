const platforms = [
  "WooCommerce", "PrestaShop", "Magento", "Shopify", 
  "IdoSell", "Shoper", "Sky-Shop", "BaseLinker",
  "Allegro Brand Zone", "Amazon", "Empik Marketplace", "Custom CMS"
];

const industries = [
  { name: "Elektronika", icon: "📱" },
  { name: "Moda i odzież", icon: "👕" },
  { name: "Dom i ogród", icon: "🏡" },
