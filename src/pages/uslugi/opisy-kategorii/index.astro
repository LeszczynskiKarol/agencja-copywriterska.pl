    icon: "🎯"
  }
];

const benefits = [
  {
    icon: "📈",
    title: "Wyższe pozycje w Google",
    description: "Zoptymalizowane opisy kategorii pomagają stronom kategorii rankować wyżej na frazy produktowe i ogólne."
  },
  {
    icon: "🚀",
    title: "Więcej ruchu organicznego",
    description: "Nasi klienci notują średnio 45% wzrost ruchu organicznego na stronach kategorii po wdrożeniu opisów."
  },
  {
    icon: "🛒",
