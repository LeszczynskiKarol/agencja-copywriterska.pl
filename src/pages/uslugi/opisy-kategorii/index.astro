  {
    title: "Opis kategorii podstawowy",
    description: "Krótki, treściwy opis wprowadzający do kategorii. Idealne do podkategorii i mniejszych działów.",
    features: ["300-500 słów", "Główne słowa kluczowe", "Wprowadzenie do kategorii", "Szybka realizacja"],
    price: "od 80 zł/szt.",
    icon: "📝"
  },
  {
    title: "Opis kategorii standardowy",
    description: "Pełny opis z rozbudowanym SEO. Najczęściej wybierana opcja dla głównych kategorii sklepu.",
    features: ["500-800 słów", "Research słów kluczowych", "Struktura H2/H3", "Linkowanie wewnętrzne"],
    price: "od 120 zł/szt.",
    icon: "📄"
  },
  {
    title: "Opis kategorii premium",
    description: "Rozbudowany content SEO z elementami poradnikowymi. Maksymalna optymalizacja pod wyszukiwarki.",
    features: ["1000+ słów", "Pełny research SEO", "Elementy poradnikowe", "FAQ sekcja"],
    price: "od 200 zł/szt.",
    icon: "⭐"
  },
  {
    title: "Opis kategorii + meta",
    description: "Opis kategorii wraz z meta title i meta description. Komplet treści SEO dla strony kategorii.",
    features: ["Opis kategorii", "Meta title", "Meta description", "Alt tagi sugestie"],
    price: "od 150 zł/szt.",
    icon: "🔍"
  },
  {
    title: "Pakiet opisów kategorii",
    description: "Kompletny pakiet opisów dla całej struktury kategorii sklepu. Spójna strategia contentowa.",
    features: ["Główne kategorie", "Podkategorie", "Spójna strategia", "Rabat pakietowy"],
    price: "wycena indywidualna",
    icon: "📦"
  },
  {
    title: "Audyt + opisy kategorii",
    description: "Analiza obecnych opisów kategorii i napisanie nowych zoptymalizowanych treści.",
    features: ["Audyt SEO kategorii", "Analiza konkurencji", "Strategia słów kluczowych", "Nowe opisy"],
    price: "wycena indywidualna",
    icon: "📊"
  }
];

const seoElements = [
  {
    title: "Słowa kluczowe",
    description: "Naturalne rozmieszczenie fraz głównych i long tail w treści opisu",
    icon: "🔑"
  },
  {
    title: "Struktura nagłówków",
    description: "Hierarchia H2, H3 wspierająca indeksowanie i czytelność",
    icon: "📑"
  },
  {
    title: "Linkowanie wewnętrzne",
    description: "Linki do produktów, podkategorii i powiązanych treści",
    icon: "🔗"
  },
  {
    title: "Meta dane",
    description: "Optymalne meta title i meta description dla każdej kategorii",
    icon: "📋"
  },
  {
