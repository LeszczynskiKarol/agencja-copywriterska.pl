---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import Stats from '../../../components/Stats.astro';
import Testimonial from '../../../components/Testimonial.astro';

const pageTitle = "Opisy Kategorii - Profesjonalne Opisy Kategorii do Sklepu | Agencja Copywriterska";
const pageDescription = "Opisy kategorii do sklepu internetowego ✓ SEO dla e-commerce ✓ Pozycjonowanie kategorii ✓ Unikalne treści ✓ Zwiększenie widoczności w Google. Zamów opisy kategorii!";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Strona główna",
      "item": "https://www.agencja-copywriterska.pl"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Usługi",
      "item": "https://www.agencja-copywriterska.pl/uslugi"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Opisy kategorii",
      "item": "https://www.agencja-copywriterska.pl/uslugi/opisy-kategorii"
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Opisy kategorii",
  "name": "Profesjonalne Opisy Kategorii do Sklepów Internetowych",
  "description": "Profesjonalne pisanie opisów kategorii do sklepów internetowych. SEO-friendly treści zwiększające widoczność kategorii w Google i wspierające pozycjonowanie e-commerce.",
  "provider": {
    "@type": "Organization",
    "name": "Agencja Copywriterska",
    "url": "https://www.agencja-copywriterska.pl",
    "telephone": "+48509370772",
    "email": "kontakt@agencja-copywriterska.pl",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Toruń",
      "addressCountry": "PL"
    }
  },
  "areaServed": {
    "@type": "Country",
    "name": "Polska"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Usługi opisów kategorii",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Opisy kategorii SEO"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Opisy kategorii e-commerce"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Opisy podkategorii"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Rozbudowane opisy kategorii"
        }
      }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Ile kosztuje opis kategorii?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cena opisu kategorii zależy od długości i złożoności. Krótki opis (300-500 słów) to koszt od 80-120 zł, standardowy opis (500-800 słów) od 120-180 zł, a rozbudowany opis SEO (1000+ słów) od 200-350 zł. Przy większych zamówieniach oferujemy rabaty."
      }
    },
    {
      "@type": "Question",
      "name": "Dlaczego opisy kategorii są ważne dla SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Opisy kategorii to kluczowy element SEO dla e-commerce. Google indeksuje strony kategorii jako ważne podstrony sklepu. Unikalna, zoptymalizowana treść pomaga kategorii rankować na frazy produktowe i zwiększa widoczność całego sklepu w wyszukiwarce."
      }
    },
    {
      "@type": "Question",
      "name": "Jak długi powinien być opis kategorii?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Optymalny opis kategorii ma 500-1000 słów. Krótsze opisy (300-500 słów) sprawdzają się przy podkategoriach. Dla głównych kategorii rekomendujemy dłuższe opisy (800-1500 słów), które dają więcej miejsca na słowa kluczowe i wartościowy content."
      }
    },
    {
      "@type": "Question",
      "name": "Czy opisy kategorii są unikalne?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak, każdy opis kategorii piszemy od podstaw. Gwarantujemy 100% unikalności – wszystkie opisy przechodzą weryfikację antyplagiatową. Unikalne treści są niezbędne dla skutecznego SEO."
      }
    },
    {
      "@type": "Question",
      "name": "Gdzie umieścić opis kategorii w sklepie?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Opis kategorii najlepiej umieścić nad lub pod listą produktów. Część sklepów pokazuje krótki wstęp na górze i pełny opis na dole strony. Doradzimy optymalne rozwiązanie dla Twojej platformy e-commerce."
      }
    },
    {
      "@type": "Question",
      "name": "Jak długo trwa napisanie opisów kategorii?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Czas realizacji zależy od ilości kategorii. 10-20 opisów to 5-7 dni roboczych. 50+ opisów to 2-3 tygodnie. Przy pilnych zleceniach możemy przyspieszyć realizację."
      }
    },
    {
      "@type": "Question",
      "name": "Czy pomagacie w doborze słów kluczowych?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak! Przeprowadzamy research słów kluczowych dla każdej kategorii. Analizujemy frazy o najwyższym potencjale i naturalnie wplatamy je w treść opisu. To część naszej standardowej usługi."
      }
    },
    {
      "@type": "Question",
      "name": "Czy piszecie opisy do sklepów na Allegro?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak, piszemy opisy kategorii i stron informacyjnych dla sklepów na Allegro (Allegro Brand Zone), a także dla innych marketplace'ów. Dostosowujemy treści do specyfiki każdej platformy."
      }
    }
  ]
};

const stats = [
  { value: "2000", suffix: "+", label: "opisów kategorii" },
  { value: "150", suffix: "+", label: "sklepów obsłużonych" },
  { value: "45", suffix: "%", label: "średni wzrost ruchu organicznego" },
  { value: "15", suffix: "+", label: "lat doświadczenia" }
];

const testimonials = [
