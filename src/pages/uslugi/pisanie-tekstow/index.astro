---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import Stats from '../../../components/Stats.astro';
import Testimonial from '../../../components/Testimonial.astro';

const pageTitle = "Pisanie Tekstów na Zamówienie - Profesjonalne Treści na Zlecenie | Agencja Copywriterska";
const pageDescription = "Pisanie tekstów na zamówienie ✓ Tworzenie tekstów na zlecenie ✓ Treści na strony WWW ✓ Teksty firmowe ✓ 15+ lat doświadczenia ✓ 5000+ napisanych tekstów. Zamów wycenę!";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Strona główna",
      "item": "https://www.agencja-copywriterska.pl"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Usługi",
      "item": "https://www.agencja-copywriterska.pl/uslugi"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Pisanie tekstów",
      "item": "https://www.agencja-copywriterska.pl/uslugi/pisanie-tekstow"
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Pisanie tekstów na zamówienie",
  "name": "Profesjonalne Pisanie Tekstów na Zlecenie",
  "description": "Profesjonalne usługi pisania tekstów na zamówienie obejmujące tworzenie treści na strony internetowe, tekstów firmowych, opisów, artykułów i wszelkich materiałów pisemnych.",
  "provider": {
    "@type": "Organization",
    "name": "Agencja Copywriterska",
    "url": "https://www.agencja-copywriterska.pl",
    "telephone": "+48509370772",
    "email": "kontakt@agencja-copywriterska.pl",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Toruń",
      "addressCountry": "PL"
    }
  },
  "areaServed": {
    "@type": "Country",
    "name": "Polska"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Usługi pisania tekstów",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Teksty na strony WWW"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Teksty firmowe"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Treści SEO"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Teksty marketingowe"
        }
      }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Ile kosztuje pisanie tekstów na zamówienie?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ceny pisania tekstów na zamówienie zależą od rodzaju i objętości treści. Teksty na strony WWW to koszt od 150 zł za stronę, artykuły od 200 zł, a kompleksowe teksty firmowe wyceniamy indywidualnie. Oferujemy bezpłatną wycenę każdego projektu."
      }
    },
    {
      "@type": "Question",
      "name": "Jak szybko mogę otrzymać gotowy tekst?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standardowy czas realizacji to 3-7 dni roboczych. Krótsze teksty możemy przygotować w 24-48 godzin. Przy większych projektach ustalamy harmonogram indywidualnie, zawsze dotrzymując ustalonych terminów."
      }
    },
    {
      "@type": "Question",
      "name": "Czy teksty są pisane pod SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak, wszystkie nasze teksty są domyślnie optymalizowane pod wyszukiwarki. Stosujemy naturalne rozmieszczenie słów kluczowych, właściwą strukturę nagłówków i dbamy o czytelność treści zarówno dla użytkowników, jak i robotów Google."
      }
    },
    {
      "@type": "Question",
      "name": "Jakie rodzaje tekstów piszecie na zlecenie?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tworzymy wszystkie rodzaje tekstów: treści na strony internetowe, teksty firmowe (o nas, oferta, misja), opisy produktów i usług, artykuły blogowe i eksperckie, teksty reklamowe, mailingi, posty do social media, materiały PR i wiele innych."
      }
    },
    {
      "@type": "Question",
      "name": "Czy mogę zamówić tekst na dowolny temat?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak, piszemy teksty na praktycznie każdy temat. Mamy doświadczenie w wielu branżach: od IT i technologii, przez finanse i prawo, po medycynę, modę i lifestyle. Przed rozpoczęciem pracy przeprowadzamy dokładny research tematu."
      }
    },
    {
      "@type": "Question",
      "name": "Czy teksty są unikalne?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutnie tak. Każdy tekst piszemy od podstaw, specjalnie dla konkretnego klienta. Gwarantujemy 100% unikalności - wszystkie treści przechodzą weryfikację antyplagiatową przed dostarczeniem."
      }
    },
    {
      "@type": "Question",
      "name": "Co jeśli tekst mi się nie spodoba?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "W ramach każdego zlecenia oferujemy bezpłatne poprawki. Pracujemy nad tekstem do momentu Twojej pełnej satysfakcji. Jeśli coś wymaga zmiany - po prostu nam to zgłoś, a my wprowadzimy korekty."
      }
    },
    {
      "@type": "Question",
      "name": "Jak wygląda proces zamawiania tekstów?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Proces jest prosty: 1) Kontaktujesz się z nami i opisujesz potrzeby, 2) Przygotowujemy bezpłatną wycenę w 24 godz., 3) Po akceptacji rozpoczynamy pracę, 4) Dostarczamy gotowy tekst, 5) Wprowadzamy ewentualne poprawki, 6) Otrzymujesz finalną wersję."
      }
    }
  ]
};

const stats = [
  { value: "15", suffix: "+", label: "lat doświadczenia" },
  { value: "5000", suffix: "+", label: "napisanych tekstów" },
  { value: "200", suffix: "+", label: "stałych klientów" },
  { value: "100", suffix: "%", label: "unikalnych treści" }
];

const testimonials = [
  {
    quote: "Zamówiłam teksty na całą stronę firmową. Efekt przeszedł moje oczekiwania - treści są profesjonalne, czytelne i świetnie oddają charakter naszej firmy. Polecam pisanie tekstów na zlecenie w tej agencji!",
    author: "Magdalena Zawadzka",
    role: "Właścicielka",
    company: "Studio Projektowe MZ",
    rating: 5
  },
  {
    quote: "Współpracujemy od 2 lat - regularne teksty na blog i materiały marketingowe. Zawsze na czas, zawsze wysokiej jakości. Tworzenie tekstów na zamówienie nigdy nie było tak proste.",
    author: "Krzysztof Adamski",
    role: "Marketing Director",
    company: "InnoTech Solutions",
    rating: 5
  },
  {
    quote: "Potrzebowałem pilnie tekstów na nową stronę. Dostarczyli wszystko w 3 dni, a jakość była doskonała. Pisanie tekstów na zlecenie to ich specjalność - widać lata doświadczenia.",
    author: "Robert Majewski",
    role: "CEO",
    company: "Majewski Consulting",
    rating: 5
  }
];

const textTypes = [
  {
    title: "Teksty na strony WWW",
    description: "Kompleksowe treści na strony internetowe - od strony głównej, przez podstrony usług, po sekcje O nas i Kontakt. Teksty zoptymalizowane pod SEO i konwersję.",
    features: ["Strona główna", "Podstrony usług", "O nas / O firmie", "Strony produktowe"]
  },
  {
    title: "Teksty firmowe",
    description: "Profesjonalne treści budujące wizerunek firmy: misja, wizja, wartości, historia firmy, prezentacje dla inwestorów i partnerów biznesowych.",
    features: ["Misja i wizja", "Historia firmy", "Wartości firmowe", "Prezentacje biznesowe"]
  },
  {
    title: "Treści SEO",
    description: "Teksty zoptymalizowane pod wyszukiwarki, które pozycjonują Twoją stronę wysoko w Google i przyciągają organiczny ruch z wyszukiwarek.",
    features: ["Artykuły SEO", "Opisy kategorii", "Teksty zapleczowe", "Content pillar pages"]
  },
  {
    title: "Teksty marketingowe",
    description: "Treści wspierające działania marketingowe: ulotki, broszury, katalogi, materiały promocyjne, teksty do kampanii reklamowych.",
    features: ["Ulotki i broszury", "Katalogi produktów", "Materiały BTL", "Teksty do reklam"]
  },
  {
    title: "Treści do social media",
    description: "Angażujące posty na Facebook, Instagram, LinkedIn i inne platformy. Budujemy społeczność i zwiększamy zasięgi Twojej marki.",
    features: ["Posty na Facebook", "Treści na Instagram", "Artykuły LinkedIn", "Opisy i bio"]
  },
  {
    title: "Teksty specjalistyczne",
    description: "Treści wymagające wiedzy branżowej: teksty medyczne, prawnicze, techniczne, finansowe. Współpracujemy z ekspertami z różnych dziedzin.",
    features: ["Teksty medyczne", "Treści prawnicze", "Opisy techniczne", "Teksty finansowe"]
  }
];

const benefits = [
  {
    icon: "✍️",
    title: "15+ lat doświadczenia",
    description: "Ponad dekada pisania tekstów dla firm z różnych branż. Tysiące zrealizowanych projektów i setki zadowolonych klientów."
  },
  {
    icon: "🎯",
    title: "Teksty szyte na miarę",
    description: "Każdy tekst tworzymy indywidualnie pod Twoje potrzeby. Żadnych szablonów - tylko unikalne treści dopasowane do Twojej marki."
  },
  {
    icon: "🔍",
    title: "Optymalizacja SEO",
    description: "Wszystkie teksty są domyślnie zoptymalizowane pod wyszukiwarki. Pomagamy Ci być widocznym w Google."
  },
  {
    icon: "⚡",
    title: "Szybka realizacja",
    description: "Standardowe projekty w 3-7 dni. Pilne zlecenia nawet w 24 godz. Zawsze dotrzymujemy terminów."
  },
  {
    icon: "✅",
    title: "100% unikalności",
    description: "Gwarantujemy pełną oryginalność każdego tekstu. Weryfikacja antyplagiatowa w standardzie."
  },
  {
    icon: "🔄",
    title: "Bezpłatne poprawki",
    description: "Pracujemy do Twojej pełnej satysfakcji. Poprawki w ramach zlecenia są zawsze bezpłatne."
  }
];

const processSteps = [
  {
    number: "01",
    title: "Kontakt i brief",
    description: "Opisujesz swoje potrzeby - jaki tekst, na jaki temat, dla kogo. Odpowiadamy na pytania i doradzamy."
  },
  {
    number: "02",
    title: "Wycena w 24 godz.",
    description: "Przygotowujemy szczegółową, bezpłatną wycenę. Podajemy koszt, termin realizacji i zakres prac."
  },
  {
    number: "03",
    title: "Tworzenie tekstu",
    description: "Po akceptacji wyceny zabieramy się do pracy. Research, pisanie, optymalizacja - wszystko w naszych rękach."
  },
  {
    number: "04",
    title: "Dostarczenie i poprawki",
    description: "Otrzymujesz gotowy tekst. Jeśli coś wymaga zmiany - wprowadzamy poprawki do skutku."
  }
];

const industries = [
  "IT i technologie", "E-commerce", "Finanse i bankowość", "Prawo", "Medycyna i zdrowie", 
  "Budownictwo", "Nieruchomości", "Edukacja", "Marketing", "HR i rekrutacja",
  "Moda i uroda", "Sport i fitness", "Gastronomia", "Turystyka", "Motoryzacja", "Przemysł"
];
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords="pisanie tekstów na zamówienie, tworzenie tekstów na zlecenie, pisanie tekstów, teksty na zlecenie, teksty na zamówienie, pisanie treści, copywriter, teksty na stronę"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Pisanie tekstów</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__bg">
      <div class="hero__pattern"></div>
      <div class="hero__gradient"></div>
    </div>
    <div class="container">
      <div class="hero__content">
        <span class="hero__badge animate-fade-in">Profesjonalne usługi copywriterskie</span>
        <h1 class="hero__title animate-fade-in" style="animation-delay: 0.1s">
          <strong>Pisanie tekstów na zamówienie</strong> – treści, które działają
        </h1>
        <p class="hero__subtitle animate-fade-in" style="animation-delay: 0.2s">
          Profesjonalne <strong>tworzenie tekstów na zlecenie</strong> dla firm i osób prywatnych. 
          Od treści na strony WWW, przez teksty firmowe, po specjalistyczne materiały branżowe. 
          Ponad 5000 napisanych tekstów, 15+ lat doświadczenia.
        </p>
        <div class="hero__cta animate-fade-in" style="animation-delay: 0.3s">
          <a href="/kontakt/" class="btn btn--primary btn--lg">
            Zamów tekst na zlecenie
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="#rodzaje-tekstow" class="btn btn--secondary btn--lg">
            Zobacz, co piszemy
          </a>
        </div>
        <div class="hero__trust animate-fade-in" style="animation-delay: 0.4s">
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Wycena w 24 godz.</span>
          </div>
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>100% unikalnych treści</span>
          </div>
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Bezpłatne poprawki</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="container">
      <Stats items={stats} variant="dark" />
    </div>
  </section>

  <!-- What is Section -->
  <section class="section what-is" id="o-usludze">
    <div class="container">
      <div class="what-is__grid">
        <div class="what-is__content">
          <SectionHeading
            label="O usłudze"
            title="Czym jest <span class='accent'>pisanie tekstów na zamówienie</span>?"
            align="left"
          />
          <div class="what-is__text">
            <p>
              <strong>Pisanie tekstów na zamówienie</strong> to profesjonalna usługa tworzenia treści pisemnych 
              na zlecenie klienta. Obejmuje wszystkie rodzaje tekstów – od krótkich opisów produktów, przez 
              rozbudowane artykuły, po kompleksowe treści na całe strony internetowe.
            </p>
            <p>
              W przeciwieństwie do gotowych szablonów czy automatycznie generowanych treści, <strong>teksty 
              na zlecenie</strong> są pisane od podstaw, z uwzględnieniem indywidualnych potrzeb klienta, 
              specyfiki branży i grupy docelowej. Każdy tekst jest unikalny i dopasowany do konkretnego celu.
            </p>
            <p>
              Nasza agencja specjalizuje się w <strong>tworzeniu tekstów na zlecenie</strong> od ponad 15 lat. 
              Napisaliśmy ponad 5000 tekstów dla firm z najróżniejszych branż – od startupów technologicznych, 
              przez kancelarie prawne, po sklepy internetowe i korporacje. Wiemy, jak pisać, żeby teksty 
              realizowały cele biznesowe naszych klientów.
            </p>
          </div>
        </div>
        <div class="what-is__visual">
          <div class="what-is__card">
            <div class="what-is__card-icon">📝</div>
            <h3>Tekst na zamówienie to inwestycja</h3>
            <p>Profesjonalne treści budują wizerunek, przyciągają klientów i zwiększają sprzedaż.</p>
          </div>
          <div class="what-is__highlight">
            <span class="what-is__highlight-number">5000+</span>
            <span class="what-is__highlight-text">tekstów napisanych dla klientów z całej Polski</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Types of Texts Section -->
  <section class="section types" id="rodzaje-tekstow">
    <div class="container">
      <SectionHeading
        label="Co piszemy"
        title="Rodzaje <span class='accent'>tekstów na zamówienie</span>"
        subtitle="Tworzymy wszystkie rodzaje treści pisemnych dla biznesu"
        align="center"
      />
      <div class="types__grid">
        {textTypes.map((type, index) => (
          <article class="type-card animate-fade-in" style={`animation-delay: ${index * 0.1}s`}>
            <h3 class="type-card__title">{type.title}</h3>
            <p class="type-card__description">{type.description}</p>
            <ul class="type-card__features">
              {type.features.map(feature => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <div class="types__cta">
        <a href="/kontakt/" class="btn btn--primary btn--lg">
          Zamów tekst na zlecenie
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Industries Section -->
  <section class="section industries" id="branze">
    <div class="container">
      <SectionHeading
        label="Doświadczenie"
        title="Piszemy dla <span class='accent'>każdej branży</span>"
        subtitle="Mamy doświadczenie w tworzeniu tekstów dla firm z różnych sektorów"
        align="center"
      />
      <div class="industries__grid">
        {industries.map((industry, index) => (
          <div class="industry-tag animate-fade-in" style={`animation-delay: ${index * 0.05}s`}>
            {industry}
          </div>
        ))}
      </div>
      <p class="industries__note">
        Nie widzisz swojej branży? Nie martw się – piszemy teksty na każdy temat. 
        <a href="/kontakt/">Skontaktuj się z nami</a> i powiedz, czego potrzebujesz.
      </p>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="section benefits" id="dlaczego-my">
    <div class="container">
      <SectionHeading
        label="Dlaczego my"
        title="Dlaczego warto zlecić nam <span class='accent'>pisanie tekstów</span>?"
        subtitle="Ponad 15 lat doświadczenia w tworzeniu treści dla biznesu"
        align="center"
      />
      <div class="benefits__grid">
        {benefits.map((benefit, index) => (
          <div class="benefit-card animate-fade-in" style={`animation-delay: ${index * 0.1}s`}>
            <span class="benefit-card__icon">{benefit.icon}</span>
            <h3 class="benefit-card__title">{benefit.title}</h3>
            <p class="benefit-card__description">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="section process" id="proces">
    <div class="process__bg"></div>
    <div class="container">
      <SectionHeading
        label="Jak działamy"
        title="Jak zamówić <span class='accent'>tekst na zlecenie</span>?"
        subtitle="Prosty proces w 4 krokach"
        align="center"
      />
      <div class="process__steps">
        {processSteps.map((step, index) => (
          <div class="process-step animate-fade-in" style={`animation-delay: ${index * 0.15}s`}>
            <span class="process-step__number">{step.number}</span>
            <div class="process-step__content">
              <h3 class="process-step__title">{step.title}</h3>
              <p class="process-step__description">{step.description}</p>
            </div>
            {index < processSteps.length - 1 && (
              <div class="process-step__connector">
