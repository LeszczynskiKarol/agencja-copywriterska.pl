---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords="pisanie artykułów, artykuły na zlecenie, pisanie artykułów na zamówienie, artykuły blogowe, artykuły eksperckie, publikacja artykułów, artykuły sponsorowane, content marketing"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Pisanie artykułów</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__bg">
      <div class="hero__pattern"></div>
      <div class="hero__gradient"></div>
    </div>
    <div class="container">
      <div class="hero__content">
        <span class="hero__badge animate-fade-in">Artykuły + publikacja w mediach</span>
        <h1 class="hero__title animate-fade-in" style="animation-delay: 0.1s">
          <strong>Pisanie artykułów</strong> z&nbsp;publikacją w&nbsp;wybranym medium
        </h1>
        <p class="hero__subtitle animate-fade-in" style="animation-delay: 0.2s">
          Profesjonalne <strong>pisanie artykułów na zlecenie</strong> – od blogowych po eksperckie. 
          Publikujemy w portalu, który wskażesz, lub dobieramy odpowiednie medium do Twojej branży. 
          Ponad 3000 napisanych artykułów, 500+ publikacji w mediach.
        </p>
        <div class="hero__cta animate-fade-in" style="animation-delay: 0.3s">
          <a href="/kontakt/" class="btn btn--primary btn--lg">
            Zamów artykuł z publikacją
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="#opcje-publikacji" class="btn btn--secondary btn--lg">
            Zobacz opcje publikacji
          </a>
        </div>
        <div class="hero__trust animate-fade-in" style="animation-delay: 0.4s">
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>100+ portali partnerskich</span>
          </div>
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Publikacja w Twoim lub naszym medium</span>
          </div>
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Pełna optymalizacja SEO</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="container">
      <Stats items={stats} variant="dark" />
    </div>
  </section>

  <!-- What is Section -->
  <section class="section what-is" id="o-usludze">
    <div class="container">
      <div class="what-is__grid">
        <div class="what-is__content">
          <SectionHeading
            label="O usłudze"
            title="<span class='accent'>Pisanie artykułów</span> z publikacją – jak to działa?"
            align="left"
          />
          <div class="what-is__text">
            <p>
              Nasze <strong>pisanie artykułów na zlecenie</strong> to więcej niż tworzenie treści. Oferujemy 
              kompleksową usługę obejmującą napisanie profesjonalnego artykułu oraz jego publikację w wybranym 
              przez Ciebie lub przez nas medium.
            </p>
            <p>
              Możesz wskazać konkretny portal, w którym chcesz się pojawić – zajmiemy się negocjacją z redakcją 
              i publikacją. Możemy też zaproponować odpowiednie medium dopasowane do Twojej branży, budżetu 
              i grupy docelowej. Mamy dostęp do ponad 100 portali o różnej tematyce i zasięgu.
            </p>
            <p>
              Oczywiście możesz też zamówić sam artykuł do publikacji na własnym blogu lub stronie. 
              Niezależnie od wybranej opcji, każdy artykuł jest profesjonalnie napisany, zoptymalizowany 
              pod SEO i dopasowany do Twoich celów marketingowych.
            </p>
          </div>
        </div>
        <div class="what-is__visual">
          <div class="what-is__card">
            <div class="what-is__card-icon">📰</div>
            <h3>Twój wybór lub nasza rekomendacja</h3>
            <p>Wskażesz portal? Opublikujemy tam. Nie wiesz, gdzie? Dobierzemy idealne medium dla Ciebie.</p>
          </div>
          <div class="what-is__highlight">
            <span class="what-is__highlight-number">100+</span>
            <span class="what-is__highlight-text">portali partnerskich do publikacji artykułów</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Publication Options Section -->
  <section class="section publication-options" id="opcje-publikacji">
    <div class="container">
      <SectionHeading
        label="Opcje publikacji"
        title="Wybierz formę <span class='accent'>publikacji artykułu</span>"
        subtitle="Elastyczne opcje dopasowane do Twoich potrzeb i budżetu"
        align="center"
      />
      <div class="options__grid">
        {publicationOptions.map((option, index) => (
          <div class="option-card animate-fade-in" style={`animation-delay: ${index * 0.1}s`}>
            <div class="option-card__header">
              <h3 class="option-card__title">{option.title}</h3>
              <span class="option-card__price">{option.price}</span>
            </div>
            <p class="option-card__description">{option.description}</p>
            <ul class="option-card__features">
              {option.features.map(feature => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {feature}
                </li>
              ))}
            </ul>
            <a href="/kontakt/" class="option-card__btn">Zapytaj o wycenę</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Article Types Section -->
  <section class="section types" id="rodzaje-artykulow">
