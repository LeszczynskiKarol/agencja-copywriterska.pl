const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Ile kosztuje napisanie artykułu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ceny artykułów zależą od długości, tematyki i poziomu specjalizacji. Artykuły blogowe zaczynają się od 200 zł, artykuły eksperckie od 400 zł, a artykuły z publikacją w mediach od 600 zł (w zależności od portalu). Każdy projekt wyceniamy indywidualnie."
      }
    },
    {
      "@type": "Question",
      "name": "Czy możecie opublikować artykuł w wybranym przeze mnie portalu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak! Współpracujemy z wieloma portalami branżowymi i mediami. Możemy opublikować artykuł w portalu, który wskażesz, lub zaproponować odpowiednie medium dopasowane do Twojej branży i grupy docelowej. Mamy dostęp do setek portali o różnej tematyce."
      }
    },
    {
      "@type": "Question",
      "name": "Jak długo trwa napisanie artykułu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standardowy artykuł blogowy przygotowujemy w 3-5 dni roboczych. Artykuły eksperckie wymagające głębszego researchu to 5-7 dni. Publikacja w mediach zewnętrznych może wydłużyć proces o dodatkowe 3-7 dni w zależności od portalu."
      }
    },
    {
      "@type": "Question",
      "name": "Czy artykuły są zoptymalizowane pod SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak, wszystkie nasze artykuły są domyślnie zoptymalizowane pod wyszukiwarki. Dobieramy słowa kluczowe, tworzymy właściwą strukturę nagłówków, dbamy o linkowanie wewnętrzne i meta dane. Artykuły pomagają w pozycjonowaniu strony."
      }
    },
    {
      "@type": "Question",
      "name": "W jakich mediach możecie opublikować artykuł?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mamy dostęp do szerokiej bazy portali: ogólnoinformacyjne (Onet, WP, Interia), branżowe (IT, finanse, prawo, medycyna, budownictwo), biznesowe, lifestyle'owe i lokalne. Dopasowujemy medium do Twojej branży i celów marketingowych."
      }
    },
    {
      "@type": "Question",
      "name": "Czy mogę zamówić sam artykuł bez publikacji?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oczywiście! Oferujemy zarówno samo pisanie artykułów (do publikacji na Twoim blogu/stronie), jak i pełen pakiet z publikacją w zewnętrznych mediach. Wybierasz opcję, która najlepiej odpowiada Twoim potrzebom."
      }
    },
    {
      "@type": "Question",
      "name": "Jakie są korzyści z publikacji artykułów w mediach?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Publikacja w mediach buduje wizerunek eksperta, zwiększa rozpoznawalność marki, generuje wartościowe linki zwrotne (link building), przyciąga nowych klientów i wzmacnia pozycję w wynikach wyszukiwania Google."
      }
    },
    {
      "@type": "Question",
      "name": "Czy piszecie artykuły na tematy specjalistyczne?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak, mamy doświadczenie w pisaniu artykułów z wielu branż: IT, finanse, prawo, medycyna, budownictwo, nieruchomości, marketing i wiele innych. Przeprowadzamy dokładny research i w razie potrzeby konsultujemy treści z ekspertami."
      }
    }
  ]
};

