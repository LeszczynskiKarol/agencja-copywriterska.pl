---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import Stats from '../../../components/Stats.astro';
import Testimonial from '../../../components/Testimonial.astro';

const pageTitle = "Copywriting - Profesjonalne Teksty Reklamowe i Sprzedażowe | Agencja Copywriterska";
const pageDescription = "Copywriting na najwyższym poziomie ✓ Teksty reklamowe ✓ Treści sprzedażowe ✓ Content marketing ✓ 15+ lat doświadczenia ✓ 5000+ napisanych tekstów. Zamów bezpłatną wycenę!";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Strona główna",
      "item": "https://www.agencja-copywriterska.pl"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Usługi",
      "item": "https://www.agencja-copywriterska.pl/uslugi"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Copywriting",
      "item": "https://www.agencja-copywriterska.pl/uslugi/copywriting"
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Copywriting",
  "name": "Profesjonalny Copywriting - Teksty Reklamowe i Sprzedażowe",
  "description": "Profesjonalne usługi copywriterskie obejmujące tworzenie tekstów reklamowych, treści sprzedażowych, content marketingu, tekstów na strony internetowe i materiałów promocyjnych.",
  "provider": {
    "@type": "Organization",
    "name": "Agencja Copywriterska",
    "url": "https://www.agencja-copywriterska.pl",
    "telephone": "+48509370772",
    "email": "kontakt@agencja-copywriterska.pl",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Toruń",
      "addressCountry": "PL"
    }
  },
  "areaServed": {
    "@type": "Country",
    "name": "Polska"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Usługi Copywriterskie",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Copywriting reklamowy"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Copywriting sprzedażowy"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Copywriting SEO"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Content marketing"
        }
      }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Czym jest copywriting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Copywriting to sztuka tworzenia tekstów reklamowych i sprzedażowych, które przekonują odbiorców do podjęcia określonego działania. Profesjonalny copywriting łączy psychologię sprzedaży z umiejętnością pisania, tworząc treści, które nie tylko informują, ale przede wszystkim sprzedają produkty i usługi."
      }
    },
    {
      "@type": "Question",
      "name": "Ile kosztuje copywriting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ceny usług copywriterskich zależą od rodzaju i objętości tekstu. Krótkie teksty reklamowe zaczynają się od 200 zł, opisy produktów od 50-150 zł za sztukę, a kompleksowe landing page od 800 zł. Każdy projekt wyceniamy indywidualnie po bezpłatnej konsultacji."
      }
    },
    {
      "@type": "Question",
      "name": "Jak długo trwa realizacja zlecenia copywriterskiego?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standardowy czas realizacji to 3-7 dni roboczych, w zależności od objętości i złożoności projektu. Krótsze teksty reklamowe realizujemy nawet w 24-48 godzin. Przy większych projektach ustalamy harmonogram indywidualnie."
      }
    },
    {
      "@type": "Question",
      "name": "Czy teksty są unikalne i oryginalne?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak, wszystkie nasze teksty są w 100% unikalne i pisane od podstaw pod konkretny projekt. Każdy tekst przechodzi weryfikację antyplagiatową. Gwarantujemy oryginalność i pełne prawa autorskie do zamówionych treści."
      }
    },
    {
      "@type": "Question",
      "name": "Czy mogę zamówić poprawki do tekstu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oczywiście! W ramach każdego zlecenia oferujemy bezpłatne poprawki, aż tekst będzie w pełni odpowiadał Twoim oczekiwaniom. Zależy nam na Twojej satysfakcji, dlatego pracujemy nad tekstem do momentu jego akceptacji."
      }
    },
    {
      "@type": "Question",
      "name": "Jakie rodzaje copywritingu oferujecie?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oferujemy pełen zakres usług copywriterskich: copywriting reklamowy, copywriting sprzedażowy, copywriting SEO, content marketing, teksty na strony internetowe, opisy produktów, artykuły blogowe, mailingi, teksty do social media, slogany i hasła reklamowe oraz naming."
      }
    },
    {
      "@type": "Question",
      "name": "Czy copywriting pomaga w pozycjonowaniu strony?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tak, profesjonalny copywriting SEO jest kluczowy dla pozycjonowania. Tworzymy treści zoptymalizowane pod wyszukiwarki, z naturalnym rozmieszczeniem słów kluczowych, właściwą strukturą nagłówków i wartościową treścią, która przyciąga zarówno użytkowników, jak i roboty Google."
      }
    },
    {
      "@type": "Question",
      "name": "Jak wygląda proces współpracy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Proces jest prosty: 1) Bezpłatna konsultacja i brief, 2) Indywidualna wycena w 24 godz., 3) Akceptacja i rozpoczęcie pracy, 4) Dostarczenie tekstu, 5) Ewentualne poprawki, 6) Finalna akceptacja. Na każdym etapie pozostajemy w stałym kontakcie."
      }
    }
  ]
};

const stats = [
  { value: "15", suffix: "+", label: "lat doświadczenia" },
  { value: "5000", suffix: "+", label: "napisanych tekstów" },
  { value: "98", suffix: "%", label: "zadowolonych klientów" },
  { value: "24", suffix: "h", label: "czas odpowiedzi" }
];

const testimonials = [
  {
    quote: "Współpraca z Agencją Copywriterską to strzał w dziesiątkę. Teksty na naszą stronę zwiększyły konwersję o 40%. Copywriting na najwyższym poziomie!",
    author: "Marcin Kowalski",
    role: "Właściciel",
    company: "E-commerce Fashion",
    rating: 5
  },
  {
    quote: "Profesjonalne podejście, świetne teksty reklamowe i terminowość. Nasze kampanie Google Ads mają teraz znacznie lepsze wyniki dzięki nowym treściom.",
    author: "Anna Wiśniewska",
    role: "Marketing Manager",
    company: "Software House",
    rating: 5
  },
  {
    quote: "Zamówiłem opisy produktów dla mojego sklepu. Jakość copywritingu przeszła moje oczekiwania. Klienci chwalą, że opisy są pomocne i przekonujące.",
    author: "Piotr Nowak",
    role: "CEO",
    company: "TechGadgets.pl",
    rating: 5
  }
];

const copywritingTypes = [
  {
    title: "Copywriting reklamowy",
    description: "Teksty do kampanii reklamowych Google Ads, Facebook Ads i innych platform. Krótkie, chwytliwe komunikaty, które przyciągają uwagę i generują kliknięcia.",
    features: ["Nagłówki reklamowe", "Teksty do banerów", "Kreacje do social ads", "Slogany i hasła"]
  },
  {
    title: "Copywriting sprzedażowy",
    description: "Teksty nastawione na konwersję i sprzedaż. Landing page, oferty handlowe i materiały, które przekonują do zakupu i budują zaufanie.",
    features: ["Landing page", "Oferty handlowe", "Strony produktowe", "Sekwencje sprzedażowe"]
  },
  {
    title: "Copywriting SEO",
    description: "Treści zoptymalizowane pod wyszukiwarki, które pozycjonują Twoją stronę wysoko w Google i przyciągają organiczny ruch.",
    features: ["Artykuły SEO", "Opisy kategorii", "Teksty na stronę", "Blog firmowy"]
  },
  {
    title: "Content marketing",
    description: "Strategiczne treści budujące wizerunek eksperta i angażujące odbiorców. Długofalowa strategia contentowa dla Twojej marki.",
    features: ["Artykuły eksperckie", "Case studies", "Whitepapers", "Newsletter"]
  },
  {
    title: "Copywriting e-commerce",
    description: "Specjalistyczne teksty dla sklepów internetowych, które zwiększają sprzedaż i poprawiają doświadczenie zakupowe klientów.",
    features: ["Opisy produktów", "Opisy kategorii", "Strony O nas", "FAQ i poradniki"]
  },
  {
    title: "Copywriting B2B",
    description: "Profesjonalne treści dla firm działających w sektorze business-to-business. Budujemy wiarygodność i generujemy leady.",
    features: ["Strony firmowe", "Prezentacje", "Materiały sprzedażowe", "LinkedIn content"]
  }
];

const benefits = [
  {
    icon: "✍️",
    title: "15+ lat doświadczenia",
    description: "Ponad dekada w branży copywriterskiej. Tysiące zrealizowanych projektów dla firm z różnych sektorów."
  },
  {
    icon: "🎯",
    title: "Teksty, które sprzedają",
    description: "Łączymy psychologię sprzedaży z copywritingiem. Nasze teksty nie tylko informują – przekonują do działania."
  },
  {
    icon: "🔍",
    title: "Optymalizacja SEO",
    description: "Każdy tekst jest zoptymalizowany pod wyszukiwarki. Naturalne słowa kluczowe, właściwa struktura, wartościowa treść."
  },
  {
    icon: "⚡",
    title: "Szybka realizacja",
    description: "Standardowe projekty realizujemy w 3-7 dni. Pilne zlecenia nawet w 24 godziny. Zawsze dotrzymujemy terminów."
  },
  {
    icon: "✅",
    title: "100% unikalności",
    description: "Gwarantujemy pełną oryginalność tekstów. Każdy tekst przechodzi weryfikację antyplagiatową."
  },
  {
    icon: "🔄",
    title: "Bezpłatne poprawki",
    description: "Pracujemy do momentu Twojej pełnej satysfakcji. Poprawki w ramach zlecenia są zawsze bezpłatne."
  }
];

const processSteps = [
  {
    number: "01",
    title: "Bezpłatna konsultacja",
    description: "Omawiamy Twoje potrzeby, cele i grupę docelową. Poznajemy specyfikę Twojej branży i oczekiwania względem tekstów."
  },
  {
    number: "02",
    title: "Brief i wycena",
    description: "Na podstawie konsultacji przygotowujemy szczegółowy brief i indywidualną wycenę. Odpowiadamy w ciągu 24 godzin."
  },
  {
    number: "03",
    title: "Tworzenie treści",
    description: "Nasi copywriterzy tworzą teksty zgodnie z briefem. Research, pisanie, optymalizacja – wszystko pod Twój projekt."
  },
  {
    number: "04",
    title: "Korekta i akceptacja",
    description: "Otrzymujesz gotowy tekst do weryfikacji. Wprowadzamy poprawki aż do pełnej akceptacji z Twojej strony."
  }
];
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords="copywriting, copywriter, teksty reklamowe, treści sprzedażowe, content marketing, copywriting SEO, teksty na stronę, agencja copywriterska"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Copywriting</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__bg">
      <div class="hero__pattern"></div>
      <div class="hero__gradient"></div>
    </div>
    <div class="container">
      <div class="hero__content">
        <span class="hero__badge animate-fade-in">Profesjonalne usługi copywriterskie</span>
        <h1 class="hero__title animate-fade-in" style="animation-delay: 0.1s">
          <strong>Copywriting</strong>, który sprzedaje i&nbsp;buduje marki
        </h1>
        <p class="hero__subtitle animate-fade-in" style="animation-delay: 0.2s">
          Tworzymy <strong>teksty reklamowe</strong> i <strong>treści sprzedażowe</strong>, które przekonują odbiorców do działania. 
          Ponad 15 lat doświadczenia, 5000+ napisanych tekstów, 98% zadowolonych klientów.
        </p>
        <div class="hero__cta animate-fade-in" style="animation-delay: 0.3s">
          <a href="/kontakt/" class="btn btn--primary btn--lg">
            Zamów bezpłatną wycenę
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="#rodzaje-copywritingu" class="btn btn--secondary btn--lg">
            Zobacz, co oferujemy
          </a>
        </div>
        <div class="hero__trust animate-fade-in" style="animation-delay: 0.4s">
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Odpowiedź w 24 godz.</span>
          </div>
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>100% unikalnych tekstów</span>
          </div>
          <div class="hero__trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Bezpłatne poprawki</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="container">
      <Stats items={stats} variant="dark" />
    </div>
  </section>

  <!-- What is Copywriting Section -->
  <section class="section what-is" id="czym-jest-copywriting">
    <div class="container">
      <div class="what-is__grid">
        <div class="what-is__content">
          <SectionHeading
            label="Definicja"
            title="Czym jest <span class='accent'>copywriting</span>?"
            align="left"
          />
          <div class="what-is__text">
            <p>
              <strong>Copywriting</strong> to sztuka tworzenia tekstów reklamowych i sprzedażowych, których celem jest przekonanie 
              odbiorcy do podjęcia określonego działania – zakupu produktu, skorzystania z usługi, zapisania się na newsletter 
              czy wypełnienia formularza kontaktowego.
            </p>
            <p>
              W odróżnieniu od zwykłego pisania, profesjonalny <strong>copywriting</strong> łączy w sobie znajomość psychologii 
              sprzedaży, marketingu i sztuki perswazji. Dobry <strong>copywriter</strong> wie, jak budować komunikaty, które 
              nie tylko przyciągają uwagę, ale przede wszystkim konwertują – zamieniają czytelników w klientów.
            </p>
            <p>
              Nasze usługi <strong>copywriterskie</strong> obejmują pełen zakres treści marketingowych: od krótkich tekstów 
              reklamowych, przez rozbudowane landing page, aż po kompleksowe strategie content marketingowe. Każdy tekst 
              tworzymy z myślą o konkretnych celach biznesowych i grupie docelowej klienta.
            </p>
          </div>
        </div>
        <div class="what-is__visual">
          <div class="what-is__card">
            <div class="what-is__card-icon">✍️</div>
            <h3>Copywriting to nie tylko pisanie</h3>
            <p>To strategia komunikacji, która zamienia słowa w wyniki biznesowe.</p>
          </div>
          <div class="what-is__highlight">
            <span class="what-is__highlight-number">40%</span>
            <span class="what-is__highlight-text">średni wzrost konwersji dzięki profesjonalnym tekstom</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Types of Copywriting Section -->
  <section class="section types" id="rodzaje-copywritingu">
    <div class="container">
      <SectionHeading
        label="Nasza oferta"
        title="Rodzaje <span class='accent'>copywritingu</span>, które oferujemy"
        subtitle="Kompleksowe usługi copywriterskie dopasowane do Twoich potrzeb biznesowych"
        align="center"
      />
      <div class="types__grid">
        {copywritingTypes.map((type, index) => (
          <article class="type-card animate-fade-in" style={`animation-delay: ${index * 0.1}s`}>
            <h3 class="type-card__title">{type.title}</h3>
            <p class="type-card__description">{type.description}</p>
            <ul class="type-card__features">
              {type.features.map(feature => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <div class="types__cta">
        <a href="/kontakt/" class="btn btn--primary btn--lg">
          Zapytaj o wycenę
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="section benefits" id="dlaczego-my">
    <div class="container">
      <SectionHeading
        label="Dlaczego my"
        title="Dlaczego warto zlecić <span class='accent'>copywriting</span> naszej agencji?"
        subtitle="Ponad 15 lat doświadczenia w tworzeniu tekstów, które sprzedają"
        align="center"
      />
      <div class="benefits__grid">
        {benefits.map((benefit, index) => (
          <div class="benefit-card animate-fade-in" style={`animation-delay: ${index * 0.1}s`}>
            <span class="benefit-card__icon">{benefit.icon}</span>
            <h3 class="benefit-card__title">{benefit.title}</h3>
            <p class="benefit-card__description">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="section process" id="proces">
    <div class="process__bg"></div>
    <div class="container">
      <SectionHeading
        label="Jak działamy"
        title="Proces współpracy <span class='accent'>copywriterskiej</span>"
        subtitle="Od briefu do gotowego tekstu w 4 prostych krokach"
        align="center"
      />
      <div class="process__steps">
        {processSteps.map((step, index) => (
          <div class="process-step animate-fade-in" style={`animation-delay: ${index * 0.15}s`}>
            <span class="process-step__number">{step.number}</span>
            <div class="process-step__content">
              <h3 class="process-step__title">{step.title}</h3>
              <p class="process-step__description">{step.description}</p>
            </div>
            {index < processSteps.length - 1 && (
              <div class="process-step__connector">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </div>
            )}
          </div>
        ))}
      </div>
      <div class="process__cta">
        <a href="/kontakt/" class="btn btn--primary btn--lg">
          Rozpocznij współpracę
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="section testimonials" id="opinie">
    <div class="container">
      <SectionHeading
        label="Opinie klientów"
        title="Co mówią o naszym <span class='accent'>copywritingu</span>?"
        subtitle="Zaufało nam ponad 500 firm z całej Polski"
        align="center"
      />
      <div class="testimonials__grid">
        {testimonials.map((testimonial, index) => (
          <Testimonial
            quote={testimonial.quote}
            author={testimonial.author}
            role={testimonial.role}
            company={testimonial.company}
            rating={testimonial.rating}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section faq" id="faq">
    <div class="container">
      <SectionHeading
        label="FAQ"
